# PostgreSQL connection (required on Vercel and locally after the SQLite → Postgres switch).
# Neon on Vercel Marketplace usually injects DATABASE_URL (pooled) — set DIRECT_URL to the
# non-pooled / "direct" connection string. For a single local Postgres instance, use the same URL for both.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional: cookie for scripts/fetch_products.py (local scraping only — not required for the app)
# PETVET_COOKIE=
