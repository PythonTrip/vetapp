# Existing PostgreSQL. Use host.docker.internal for a database on the Docker host.
DATABASE_ADDRESS=host.docker.internal
DATABASE_PORT=15432
DATABASE_NAME=vet_app
DATABASE_USER=vet_app
DATABASE_PASSWORD='change-me'
DATABASE_SSLMODE=prefer
INSTANCE_PASSWORD="change-me"

# VPS ports used by the reverse proxy.
FRONTEND_PORT=3003
API_PORT=8001

# Public HTTPS addresses. The reverse proxy must strip the /api prefix.
NEXT_PUBLIC_API_URL="https://vetapp.syndex-ai.ru/api"
FRONTEND_URL="https://vetapp.syndex-ai.ru"

# Lesion photos and documents (metadata stays in PostgreSQL)
ATTACHMENT_DIR="data/attachments"
