# Shared Postgres on Docker network shared-backend (hostname from that stack, e.g. pgsql).
# For Postgres published on the Docker host instead, use host.docker.internal.
DATABASE_ADDRESS=pgsql
DATABASE_PORT=5432
DATABASE_NAME=vet_app
DATABASE_USER=vet_app
DATABASE_PASSWORD='change-me'
DATABASE_SSLMODE=prefer
# Local SSH tunnel; in Docker use a service hostname or host.docker.internal.
MODULE_AUTH_URL=http://127.0.0.1:8321
# true for HTTPS deployments, false only for local HTTP
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
# JSON list of additional exact browser origins allowed by API CORS and CSRF.
API_ALLOWED_ORIGINS=[]

# Host loopback ports (unique among apps on this VPS). Bound to 127.0.0.1 only.
FRONTEND_PORT=3003
API_PORT=8001

# Browser → same-origin /api → Next Route Handler → Docker DNS vetapp-api.
NEXT_PUBLIC_API_URL=/api
API_INTERNAL_URL=http://vetapp-api:8000
FRONTEND_URL="https://vetapp.syndex-ai.ru"
# Keep this origin for a gradual migration with existing owner cookies.
# For a separate owner domain, set its exact HTTPS origin here and route it to owner-web.
OWNER_FRONTEND_URL="https://vetapp.syndex-ai.ru"
OWNER_FRONTEND_PORT=3004

# Lesion photos and documents (metadata stays in PostgreSQL)
ATTACHMENT_DIR="/data/attachments"
