{
  "name": "vetdietderm-owner-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "check": "pnpm typecheck && pnpm lint",
    "typecheck": "tsc --noEmit",
    "lint": "cd ../.. && node apps/owner-web/node_modules/eslint/bin/eslint.js apps/owner-web/src packages/owner-features/src packages/ui/src packages/web-proxy/src packages/api-client/src/http.ts --config eslint.owner.config.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "@vetdietderm/owner-features": "workspace:*",
    "@vetdietderm/ui": "workspace:*",
    "@vetdietderm/web-proxy": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "happy-dom": "^20.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "@vetdietderm/api-client": "workspace:*"
  }
}
