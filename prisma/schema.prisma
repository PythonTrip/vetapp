// VetDietDerm - Micro-CRM for Veterinary Nutritionists & Dermatologists
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled URL for the app (Neon/Vercel). Use the same value as DIRECT_URL for local Postgres.
  url       = env("DATABASE_URL")
  // Direct (non-pooled) URL for Prisma Migrate on Neon.
  directUrl = env("DIRECT_URL")
}

model Pet {
  id            String   @id @default(cuid())
  name          String
  species       String // dog | cat
  breed         String
  birthDate     DateTime
  sex           String // male | female
  neutered      Boolean  @default(false)
  ownerName     String
  ownerContact  String // combined "email · phone", kept for compatibility/export
  ownerEmail    String?
  ownerPhone    String?
  // Nutritional metrics
  currentWeight Float // kg
  targetWeight  Float? // kg
  bcs           Int // 1-9 Body Condition Score
  lifeStage     String // puppy/kitten | adult | senior | gestation | lactation
  activityLevel String // low | moderate | high | very_high
  // Repeatable anamnesis baseline — entered once, auto-filled into every visit
  allergies         String  @default("[]") // JSON array of strings
  chronicConditions String  @default("[]") // JSON array of strings
  feeding           String? // JSON: { foodType, brand, dailyAmount, feedingsPerDay, treats, supplements, notes }
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  consultations  Consultation[]
  photos         LesionPhoto[]
  dietPlans      DietPlan[]
  appointments   Appointment[]
  communications CommunicationLog[]
  shareTokens    ShareToken[]
}

model Consultation {
  id              String    @id @default(cuid())
  petId           String
  date            DateTime  @default(now())
  type            String // appointment | note | diagnostic | treatment
  chiefComplaint  String?
  notes           String
  transcript      String? // raw ASR transcript
  vasScore        Int? // pruritus 1-10
  weight          Float? // kg recorded at this visit
  dietPlanId      String?
  status          String    @default("completed") // draft | in_progress | completed | cancelled
  specialty       String? // dermatology | nutrition | general
  anamnesis       String?
  anamnesisData   String? // JSON: { specialty, answers: { fieldId: value } } — structured anamnesis
  physicalExam    String?
  diagnoses       String    @default("[]") // JSON string of diagnosis labels
  prescriptions   String    @default("[]") // JSON string of prescription objects
  followUpPlan    String?
  followUpDate    DateTime?
  templateKey     String?
  templateName    String?
  templateVersion Int?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  pet      Pet           @relation(fields: [petId], references: [id], onDelete: Cascade)
  dietPlan DietPlan?     @relation(fields: [dietPlanId], references: [id])
  photos   LesionPhoto[]
}

model LesionPhoto {
  id             String   @id @default(cuid())
  petId          String
  consultationId String?
  date           DateTime @default(now())
  imageData      String // base64 data URL
  caption        String?
  vasScore       Int? // pruritus 1-10 at time of photo
  bodyRegion     String? // e.g. ventrum, ears, paws
  createdAt      DateTime @default(now())

  pet          Pet           @relation(fields: [petId], references: [id], onDelete: Cascade)
  consultation Consultation? @relation(fields: [consultationId], references: [id])
}

model DietPlan {
  id        String   @id @default(cuid())
  petId     String
  name      String
  type      String // commercial | home_cooked | barf | mixed
  rer       Float // Resting Energy Requirement (kcal/day)
  mer       Float // Maintenance Energy Requirement (kcal/day)
  // macronutrient targets (grams/day) stored as JSON string
  macros    String
  // template breakdown for home-cooked/barf (JSON string of {category, ingredient, percentage, grams})
  template  String?
  notes     String?
  createdAt DateTime @default(now())

  pet           Pet            @relation(fields: [petId], references: [id], onDelete: Cascade)
  consultations Consultation[]
}

model Appointment {
  id        String   @id @default(cuid())
  petId     String
  date      DateTime
  duration  Int      @default(30) // minutes
  type      String // consultation | recheck | procedure | telemedicine
  reason    String
  status    String   @default("scheduled") // scheduled | completed | cancelled | no_show
  notes     String?
  createdAt DateTime @default(now())

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)
}

// User-created custom treatment plan templates (extends the 10 built-in ones)
model CustomTemplate {
  id             String   @id @default(cuid())
  name           String
  category       String // dermatology | nutrition | wellness | emergency | custom
  description    String?
  icon           String   @default("Stethoscope")
  type           String // appointment | note | diagnostic | treatment
  chiefComplaint String?
  notes          String
  suggestedVas   Int?
  duration       String?
  templateKey    String?  @default(cuid())
  version        Int      @default(1)
  isLatest       Boolean  @default(true)
  sections       String? // JSON snapshot of structured consultation sections
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Persisted owner communications (cross-device sync, replaces localStorage)
model CommunicationLog {
  id        String   @id @default(cuid())
  petId     String
  channel   String // phone | email | text | video | in_person
  direction String // inbound | outbound
  date      DateTime
  duration  Int? // minutes (for calls/video)
  subject   String?
  notes     String?
  followUp  Boolean  @default(false)
  createdAt DateTime @default(now())

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)
}

// User-created custom handout templates (extends the 6 built-in ones)
model CustomHandout {
  id          String   @id @default(cuid())
  title       String
  description String?
  prompt      String // the AI prompt template (with {{petName}}, {{species}} placeholders)
  category    String   @default("general") // general | dermatology | nutrition | wellness | behavioral
  icon        String   @default("FileText")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Shareable owner portal tokens — read-only access to a specific pet's report
model ShareToken {
  id        String    @id @default(cuid())
  token     String    @unique // short URL-safe random string
  petId     String
  label     String? // e.g. "Sent to owner via email"
  expiresAt DateTime
  viewedAt  DateTime? // last access timestamp
  viewCount Int       @default(0)
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)
}

// Searchable nutrition catalogue imported from products_normalized.json.
model NutritionProduct {
  id        Int                        @id @default(autoincrement())
  name      String
  searchName String
  category  String
  subcategory String?
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt
  nutrients NutritionProductNutrient[]

  @@unique([name, category])
  @@index([category, name])
  @@index([category, subcategory, name])
  @@index([category, searchName])
}

model NutritionProductNutrient {
  id         Int              @id @default(autoincrement())
  productId  Int
  code       String
  value      Float
  calculated Boolean          @default(false)
  product    NutritionProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, code])
  @@index([code])
}
